{
  "name": "aura-ui-monorepo",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint && eslint brand.config.ts",
    "typecheck": "turbo run typecheck",
    "size": "turbo run build && size-limit",
    "storybook": "pnpm --filter @aura/docs dev",
    "build-storybook": "turbo run build-storybook",
    "pack:check": "pnpm --filter @aura/tokens exec npm pack --dry-run && pnpm --filter @aura/core exec npm pack --dry-run"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@eslint/js": "^9.25.1",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.25.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "size-limit": "^14.3.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  }
}
