{
  "$description": "Aura UI canonical tokens (W3C DTCG style). Colors below are the M3 baseline scheme for seed #6750A4. build-tokens.ts generates full tonal palettes and light/dark × standard/medium/high schemes via generate-scheme.ts.",
  "meta": { "prefix": "aura", "seed": "#6750A4", "version": "0.1.0" },

  "ref": {
    "typeface": {
      "brand": { "$type": "fontFamily", "$value": ["Roboto Flex", "Roboto", "system-ui", "sans-serif"] },
      "plain": { "$type": "fontFamily", "$value": ["Roboto Flex", "Roboto", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["Roboto Mono", "ui-monospace", "monospace"] }
    },
    "palette": {
      "$comment": "Generated: primary, secondary, tertiary, neutral, neutral-variant, error. Tones 0,10,20,25,30,35,40,50,60,70,80,90,95,98,99,100."
    }
  },

  "sys": {
    "color": {
      "light": {
        "primary": "#6750A4", "on-primary": "#FFFFFF",
        "primary-container": "#EADDFF", "on-primary-container": "#21005D",
        "primary-fixed": "#EADDFF", "primary-fixed-dim": "#D0BCFF",
        "on-primary-fixed": "#21005D", "on-primary-fixed-variant": "#4F378B",
        "secondary": "#625B71", "on-secondary": "#FFFFFF",
        "secondary-container": "#E8DEF8", "on-secondary-container": "#1D192B",
        "secondary-fixed": "#E8DEF8", "secondary-fixed-dim": "#CCC2DC",
        "on-secondary-fixed": "#1D192B", "on-secondary-fixed-variant": "#4A4458",
        "tertiary": "#7D5260", "on-tertiary": "#FFFFFF",
        "tertiary-container": "#FFD8E4", "on-tertiary-container": "#31111D",
        "tertiary-fixed": "#FFD8E4", "tertiary-fixed-dim": "#EFB8C8",
        "on-tertiary-fixed": "#31111D", "on-tertiary-fixed-variant": "#633B48",
        "error": "#B3261E", "on-error": "#FFFFFF",
        "error-container": "#F9DEDC", "on-error-container": "#410E0B",
        "surface": "#FEF7FF", "on-surface": "#1D1B20",
        "surface-variant": "#E7E0EC", "on-surface-variant": "#49454F",
        "surface-dim": "#DED8E1", "surface-bright": "#FEF7FF",
        "surface-container-lowest": "#FFFFFF", "surface-container-low": "#F7F2FA",
        "surface-container": "#F3EDF7", "surface-container-high": "#ECE6F0",
        "surface-container-highest": "#E6E0E9",
        "outline": "#79747E", "outline-variant": "#CAC4D0",
        "inverse-surface": "#322F35", "inverse-on-surface": "#F5EFF7", "inverse-primary": "#D0BCFF",
        "surface-tint": "#6750A4", "scrim": "#000000", "shadow": "#000000"
      },
      "dark": {
        "primary": "#D0BCFF", "on-primary": "#381E72",
        "primary-container": "#4F378B", "on-primary-container": "#EADDFF",
        "primary-fixed": "#EADDFF", "primary-fixed-dim": "#D0BCFF",
        "on-primary-fixed": "#21005D", "on-primary-fixed-variant": "#4F378B",
        "secondary": "#CCC2DC", "on-secondary": "#332D41",
        "secondary-container": "#4A4458", "on-secondary-container": "#E8DEF8",
        "secondary-fixed": "#E8DEF8", "secondary-fixed-dim": "#CCC2DC",
        "on-secondary-fixed": "#1D192B", "on-secondary-fixed-variant": "#4A4458",
        "tertiary": "#EFB8C8", "on-tertiary": "#492532",
        "tertiary-container": "#633B48", "on-tertiary-container": "#FFD8E4",
        "tertiary-fixed": "#FFD8E4", "tertiary-fixed-dim": "#EFB8C8",
        "on-tertiary-fixed": "#31111D", "on-tertiary-fixed-variant": "#633B48",
        "error": "#F2B8B5", "on-error": "#601410",
        "error-container": "#8C1D18", "on-error-container": "#F9DEDC",
        "surface": "#141218", "on-surface": "#E6E0E9",
        "surface-variant": "#49454F", "on-surface-variant": "#CAC4D0",
        "surface-dim": "#141218", "surface-bright": "#3B383E",
        "surface-container-lowest": "#0F0D13", "surface-container-low": "#1D1B20",
        "surface-container": "#211F26", "surface-container-high": "#2B2930",
        "surface-container-highest": "#36343B",
        "outline": "#938F99", "outline-variant": "#49454F",
        "inverse-surface": "#E6E0E9", "inverse-on-surface": "#322F35", "inverse-primary": "#6750A4",
        "surface-tint": "#D0BCFF", "scrim": "#000000", "shadow": "#000000"
      },
      "semantic-extra": {
        "$comment": "success/warning/info: harmonized to the seed via Blend.harmonize, then built with M3 contrast curves.",
        "roles": ["success", "warning", "info"],
        "seeds": {
          "success": "#2E7D32",
          "warning": "#EAB308",
          "info": "#0288D1"
        }
      }
    },

    "typescale": {
      "display-large":   { "size": "3.5625rem", "line": "4rem",     "weight": 400, "emphasizedWeight": 500, "tracking": "-0.015625rem", "family": "brand" },
      "display-medium":  { "size": "2.8125rem", "line": "3.25rem",  "weight": 400, "emphasizedWeight": 500, "tracking": "0rem",         "family": "brand" },
      "display-small":   { "size": "2.25rem",   "line": "2.75rem",  "weight": 400, "emphasizedWeight": 500, "tracking": "0rem",         "family": "brand" },
      "headline-large":  { "size": "2rem",      "line": "2.5rem",   "weight": 400, "emphasizedWeight": 500, "tracking": "0rem",         "family": "brand" },
      "headline-medium": { "size": "1.75rem",   "line": "2.25rem",  "weight": 400, "emphasizedWeight": 500, "tracking": "0rem",         "family": "brand" },
      "headline-small":  { "size": "1.5rem",    "line": "2rem",     "weight": 400, "emphasizedWeight": 500, "tracking": "0rem",         "family": "brand" },
      "title-large":     { "size": "1.375rem",  "line": "1.75rem",  "weight": 400, "emphasizedWeight": 500, "tracking": "0rem",         "family": "plain" },
      "title-medium":    { "size": "1rem",      "line": "1.5rem",   "weight": 500, "emphasizedWeight": 700, "tracking": "0.009375rem",  "family": "plain" },
      "title-small":     { "size": "0.875rem",  "line": "1.25rem",  "weight": 500, "emphasizedWeight": 700, "tracking": "0.00625rem",   "family": "plain" },
      "body-large":      { "size": "1rem",      "line": "1.5rem",   "weight": 400, "emphasizedWeight": 500, "tracking": "0.03125rem",   "family": "plain" },
      "body-medium":     { "size": "0.875rem",  "line": "1.25rem",  "weight": 400, "emphasizedWeight": 500, "tracking": "0.015625rem",  "family": "plain" },
      "body-small":      { "size": "0.75rem",   "line": "1rem",     "weight": 400, "emphasizedWeight": 500, "tracking": "0.025rem",     "family": "plain" },
      "label-large":     { "size": "0.875rem",  "line": "1.25rem",  "weight": 500, "emphasizedWeight": 700, "tracking": "0.00625rem",   "family": "plain" },
      "label-medium":    { "size": "0.75rem",   "line": "1rem",     "weight": 500, "emphasizedWeight": 700, "tracking": "0.03125rem",   "family": "plain" },
      "label-small":     { "size": "0.6875rem", "line": "1rem",     "weight": 500, "emphasizedWeight": 700, "tracking": "0.03125rem",   "family": "plain" }
    },

    "shape": {
      "none": "0",
      "extra-small": "4px",
      "small": "8px",
      "medium": "12px",
      "large": "16px",
      "large-increased": "20px",
      "extra-large": "28px",
      "extra-large-increased": "32px",
      "extra-extra-large": "48px",
      "full": "9999px"
    },

    "elevation": {
      "level0": { "shadow": "none", "tint": "0" },
      "level1": { "shadow": "0 1px 2px rgb(0 0 0 / 0.30), 0 1px 3px 1px rgb(0 0 0 / 0.15)", "tint": "0.05" },
      "level2": { "shadow": "0 1px 2px rgb(0 0 0 / 0.30), 0 2px 6px 2px rgb(0 0 0 / 0.15)", "tint": "0.08" },
      "level3": { "shadow": "0 1px 3px rgb(0 0 0 / 0.30), 0 4px 8px 3px rgb(0 0 0 / 0.15)", "tint": "0.11" },
      "level4": { "shadow": "0 2px 3px rgb(0 0 0 / 0.30), 0 6px 10px 4px rgb(0 0 0 / 0.15)", "tint": "0.12" },
      "level5": { "shadow": "0 4px 4px rgb(0 0 0 / 0.30), 0 8px 12px 6px rgb(0 0 0 / 0.15)", "tint": "0.14" }
    },

    "state": {
      "hover-opacity": 0.08,
      "focus-opacity": 0.10,
      "pressed-opacity": 0.10,
      "dragged-opacity": 0.16,
      "disabled-content-opacity": 0.38,
      "disabled-container-opacity": 0.12,
      "focus-ring": { "width": "3px", "offset": "2px", "color": "{sys.color.secondary}" }
    },

    "motion": {
      "easing": {
        "emphasized": "cubic-bezier(0.2, 0, 0, 1)",
        "emphasized-decelerate": "cubic-bezier(0.05, 0.7, 0.1, 1)",
        "emphasized-accelerate": "cubic-bezier(0.3, 0, 0.8, 0.15)",
        "standard": "cubic-bezier(0.2, 0, 0, 1)",
        "standard-decelerate": "cubic-bezier(0, 0, 0, 1)",
        "standard-accelerate": "cubic-bezier(0.3, 0, 1, 1)",
        "legacy": "cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "duration": {
        "short1": "50ms", "short2": "100ms", "short3": "150ms", "short4": "200ms",
        "medium1": "250ms", "medium2": "300ms", "medium3": "350ms", "medium4": "400ms",
        "long1": "450ms", "long2": "500ms", "long3": "550ms", "long4": "600ms",
        "extra-long1": "700ms", "extra-long2": "800ms", "extra-long3": "900ms", "extra-long4": "1000ms"
      },
      "spring": {
        "$comment": "Expressive scheme. Approximate in CSS via linear() easing; or use WAAPI.",
        "spatial": { "stiffness": 380, "damping": 0.8 },
        "effects": { "stiffness": 1600, "damping": 1 }
      }
    },

    "space": {
      "0": "0", "0-5": "2px", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px",
      "6": "24px", "8": "32px", "10": "40px", "12": "48px", "14": "56px", "16": "64px", "20": "80px", "24": "96px"
    },

    "breakpoint": {
      "compact": "0",
      "medium": "600px",
      "expanded": "840px",
      "large": "1200px",
      "extra-large": "1600px"
    },

    "icon": {
      "size": { "dense": "20px", "default": "24px", "large": "32px", "xlarge": "40px", "xxlarge": "48px" },
      "symbols": { "fill": 0, "weight": 400, "grade": 0, "opsz": 24 }
    },

    "touch-target": "48px",
    "scrim-opacity": 0.32,
    "z-index": {
      "app-bar": 100, "drawer": 200, "sheet": 300, "menu": 400, "dialog": 500, "snackbar": 600, "tooltip": 700
    }
  },

  "comp": {
    "$comment": "Defaults for component tokens. Each component CSS reads --aura-comp-<name>-* with fallbacks to sys tokens.",
    "button": {
      "container-height": { "xs": "32px", "sm": "40px", "md": "40px", "lg": "56px", "xl": "96px" },
      "container-shape": "{sys.shape.full}",
      "label-text": "{sys.typescale.label-large}",
      "icon-size": "18px",
      "horizontal-padding": "24px",
      "horizontal-padding-with-icon": "16px",
      "icon-gap": "8px"
    },
    "icon-button": { "container-size": "40px", "icon-size": "24px", "shape": "{sys.shape.full}" },
    "fab": { "size": "56px", "small": "40px", "large": "96px", "shape": "{sys.shape.large}", "elevation": "{sys.elevation.level3}" },
    "segmented-button": { "container-height": "40px", "shape": "{sys.shape.full}", "icon-size": "18px", "padding-inline": "16px" },
    "chip": { "height": "32px", "shape": "{sys.shape.small}", "icon-size": "18px", "padding-inline": "16px", "padding-inline-with-icon": "12px", "avatar-size": "24px" },
    "text-field": { "height": "56px", "shape-filled": "{sys.shape.extra-small}", "shape-outlined": "{sys.shape.extra-small}", "outline-width": "1px", "outline-width-focused": "3px" },
    "card": { "shape": "{sys.shape.medium}", "padding": "16px" },
    "dialog": { "shape": "{sys.shape.extra-large}", "min-width": "280px", "max-width": "560px", "padding": "24px" },
    "menu": { "shape": "{sys.shape.extra-small}", "item-height": "48px", "min-width": "112px", "max-width": "280px" },
    "switch": { "track-width": "52px", "track-height": "32px", "thumb-off": "16px", "thumb-on": "24px", "thumb-pressed": "28px" },
    "checkbox": { "box": "18px", "state-layer": "40px", "shape": "{sys.shape.extra-small}" },
    "slider": { "track-height": "4px", "handle-width": "4px", "handle-height": "44px" },
    "navigation-bar": { "height": "80px", "indicator-width": "64px", "indicator-height": "32px" },
    "navigation-rail": { "width": "80px", "expanded-min-width": "220px" },
    "navigation-drawer": { "width": "360px", "shape": "{sys.shape.large}" },
    "top-app-bar": { "small": "64px", "medium": "112px", "large": "152px" },
    "snackbar": { "shape": "{sys.shape.extra-small}", "min-height": "48px" },
    "tooltip": { "plain-shape": "{sys.shape.extra-small}", "rich-shape": "{sys.shape.medium}", "delay": "500ms" },
    "progress": { "linear-height": "4px", "circular-size": "48px", "circular-stroke": "4px" },
    "list": { "item-height": { "one-line": "56px", "two-line": "72px", "three-line": "88px" } },
    "badge": { "small": "6px", "large": "16px" }
  }
}
